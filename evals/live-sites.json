{
  "version": 2,
  "description": "Real-world, controlled, discovery, and manual-protected eval cases for Notturn.",
  "tracks": {
    "regression": "Small automated set for bugs and site classes that have already mattered during dogfooding.",
    "discovery": "Broad non-gating sweep for finding new missed ads, false positives, breakage, and performance patterns.",
    "controlled": "Purpose-built adblock tester pages; useful for trend checks but not product truth by themselves.",
    "manual": "Logged-in or sensitive workflows that require human testing and must not be run automatically."
  },
  "groups": {
    "real": "Legacy real-site regression set from the release-candidate phase.",
    "controlled": "External adblock test pages.",
    "discovery-news": "Broad publisher/news discovery sweep.",
    "discovery-sports": "Sports publisher and league discovery sweep.",
    "discovery-commerce": "Shopping and product-search discovery sweep.",
    "discovery-stock-search": "Image/stock search pages with affiliate image modules and promoted native grids.",
    "discovery-video": "Video and streaming discovery sweep; automated runs do not prove preroll behavior unless a case explicitly plays media.",
    "discovery-productivity": "Public productivity/utility landing pages and performance canaries.",
    "discovery-reference": "Reference, developer, and knowledge sites used for false-positive canaries.",
    "discovery-community": "Social/forum/feed sites where login walls or bot challenges are common.",
    "discovery-finance": "Finance/news/research sites with ad, tracker, and paywall variation.",
    "discovery-travel-jobs": "Travel and job-board pages with search/filter workflows.",
    "discovery-health-lifestyle": "Health, food, and lifestyle pages with high ad density.",
    "protected-manual": "Human-only logged-in workflow checks."
  },
